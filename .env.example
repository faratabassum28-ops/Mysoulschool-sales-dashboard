# ---------- Server ----------
PORT=5000
TZ_NAME=Asia/Kolkata

# ---------- Database (MongoDB) ----------
# Leave empty to run without MongoDB (cleaned rows are cached in server/data/cache.json).
MONGODB_URI=mongodb://127.0.0.1:27017/mysoulschool_sales

# ---------- Data source ----------
# auto        = Google service account if configured, otherwise public "anyone with the link" CSV export
# sheets-api  = Google Sheets API with a service account (recommended, sheet stays private)
# sheets-csv  = CSV export of a sheet shared as "Anyone with the link can view"
# csv-file    = a CSV exported from the Dashboard tab (set CSV_FILE)
# sample      = generated demo data (fake) so you can see the dashboard working
DATA_SOURCE=auto
SHEET_ID=1t_2yP18ErFwfqMWhW2C3yZb1POIxObBK8dhqyQTBOnE
SHEET_TAB=Dashboard
# Service account: paste the full JSON on one line, OR point to the file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=./data/service-account.json
CSV_FILE=

# ---------- Cleaning rules ----------
# Which row to keep when Duplicate Email / Duplicate Phone repeats: first | last
DEDUPE_KEEP=first

# ---------- Daily refresh ----------
# 06:00 every day in TZ_NAME
SYNC_CRON=0 6 * * *
SYNC_ON_BOOT=true
# Needed for POST /api/sync (send header x-sync-token). Leave empty to disable manual sync over HTTP.
SYNC_TOKEN=

# ---------- Optional login for the whole site (HTTP Basic) ----------
DASHBOARD_USER=
DASHBOARD_PASSWORD=
